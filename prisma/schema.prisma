generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  country       String?
  passwordHash  String? // Optional for OAuth users
  name          String? // For OAuth users
  oauthProvider String? // "google", "facebook", "x", or null for email/password
  oauthId       String? // OAuth provider's user ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([oauthProvider, oauthId])
}

model Subscription {
  id                     String                @id @default(cuid())
  user                   User                  @relation(fields: [userId], references: [id])
  userId                 String
  status                 SubscriptionStatus
  plan                   SubscriptionPlan?
  platform               SubscriptionPlatform?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  externalSubscriptionId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

/// Chat conversation (session). userId is either User.id or anonymous cookie-based id.
model Conversation {
  id                  String    @id @default(cuid())
  userId              String    // User.id for authenticated; cookie/generated id for anonymous
  conversationSummary String?   @map("conversation_summary") @db.Text
  summaryUpdatedAt    DateTime? @map("summary_updated_at")
  createdAt           DateTime  @default(now())
  messages            Message[]
  reflectionCheckpoints ReflectionCheckpoint[]
  reflectionRuns       ReflectionRun[]
  insights             Insight[]
}

/// User-triggered reflection checkpoint: optional user input + AI-generated summary. One per row; multiple per conversation.
model ReflectionCheckpoint {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  userInput      String?  @map("user_input") @db.Text
  summary        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

/// Single message in a conversation. Persisted on every chat exchange.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String   // Same as Conversation.userId (denormalized for queries)
  role           String   // "user" | "assistant" | "system"
  message        String   @db.Text
  createdAt      DateTime @default(now())
  metadata       Json?    // Optional JSON
  insightTags    Json?    @map("insight_tags") // Optional JSON array
}

/// V1 reflection extraction run: structured labels + insight candidate per user message (Wisewave Core Loop).
model ReflectionRun {
  id                  String   @id @default(cuid())
  conversationId      String   @map("conversation_id")
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId           String   @map("message_id")
  triggerLabel        String?  @map("trigger_label")
  emotionLabel        String?  @map("emotion_label")
  interpretationLabel String?  @map("interpretation_label")
  regulationLabel     String?  @map("regulation_label")
  choiceLabel         String?  @map("choice_label")
  insightCandidate    String?  @map("insight_candidate") @db.Text
  createdAt           DateTime @default(now())

  @@index([conversationId])
  @@index([messageId])
}

/// Durable insight saved from a reflection cycle; used for continuity strip and memory.
model Insight {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  conversationId   String   @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessageId  String   @map("source_message_id")
  corePattern      String   @map("core_pattern") @db.Text
  continuityText   String   @map("continuity_text") @db.Text
  status           String   @default("active") // active | archived
  confidenceScore  Float?   @map("confidence_score")
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @map("last_seen_at") @default(now())
  isContinuityEligible Boolean @map("is_continuity_eligible") @default(true)

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([isContinuityEligible])
}

/// Optional feedback captured about how a prior suggested action / regulation cue landed.
model Feedback {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  conversationId  String   @map("conversation_id")
  sourceMessageId String   @map("source_message_id")
  payload         Json     @db.Json
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
}

enum SubscriptionStatus {
  trialing
  active
  canceled
  expired
}

enum SubscriptionPlan {
  monthly
  yearly
}

enum SubscriptionPlatform {
  google_play
  app_store
  stripe_web
}

/// Tasks assigned to an AI agent; agent fetches by name and can submit a reply to update the task.
model AgentTask {
  id           String    @id @default(cuid())
  agentName    String    @map("agent_name")   // e.g. "Nova", "Lumen" — used to filter tasks for that agent
  title        String
  description  String?   @db.Text
  status       String    @default("open")    // open | in_progress | replied | closed
  replyContent String?   @map("reply_content") @db.Text  // set when agent submits a reply
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime? @map("archived_at")  // set when Tree archives the day; task then hidden from main list

  @@index([agentName, status])
  @@index([archivedAt])
}

/// Per-agent, per-day finalized summary written by Tree when archiving. "Archive folder" = these records; display only latest day for tomorrow.
model AgentTaskArchive {
  id               String   @id @default(cuid())
  agentName        String   @map("agent_name")
  archiveDate      String   @map("archive_date")   // YYYY-MM-DD
  finalizedContent String   @map("finalized_content") @db.Text
  createdAt        DateTime @default(now())

  @@unique([agentName, archiveDate])
  @@index([archiveDate])
}

/// Milestone H observation tool: queue + human review logs.
/// Stored in Postgres so cases don't disappear across serverless instances.
model HObservationQueueItem {
  caseId           String   @id @map("case_id")
  sourceType       String
  language         String
  conversationType String   @map("conversation_type")
  signalStrength   String   @map("signal_strength")
  previewText      String   @map("preview_text") @db.Text
  fullInput        String   @map("full_input") @db.Text
  createdAt        DateTime @map("created_at")
  reviewStatus     String   @map("review_status")
  tags             Json?    // e.g. ["mild_affect", "placeholder"]
}

model HObservationSnapshot {
  caseId    String @id @map("case_id")
  snapshot  Json   @db.Json
  updatedAt DateTime @updatedAt @map("updated_at")
}

model HObservationReviewLog {
  caseId                     String   @id @map("case_id")
  reviewer                   String
  reviewedAt                 DateTime @map("reviewed_at")

  hAppeared                  Boolean @map("h_appeared")
  cueType                    String  @map("cue_type")
  positionCorrect           Boolean @map("position_correct")

  shouldHaveBeenSuppressed  String  @map("should_have_been_suppressed")
  suppressionFlag            String  @map("suppression_flag")

  guidanceDrift             Boolean @map("guidance_drift")
  interpretiveDrift         Boolean @map("interpretive_drift")
  authorityDrift           Boolean @map("authority_drift")
  weightDrift              Boolean @map("weight_drift")
  duplicationDrift         Boolean @map("duplication_drift")

  removalResult             String @map("removal_result")
  removalConclusion         String @map("removal_conclusion")

  turnWeight                String @map("turn_weight")
  hNoticeability            String @map("h_noticeability")

  ePresent                  Boolean @map("e_present")
  fPresent                  Boolean @map("f_present")
  hCompetesWithEorF         Boolean @map("h_competes_with_e_or_f")

  // Post-linter tracking (Milestone H strict stabilization)
  linterFired                Boolean @default(false) @map("linter_fired")
  hSuppressedByLinter        Boolean @default(false) @map("h_suppressed_by_linter")
  wouldCaseHaveFailedWithoutLinter String @default("unclear") @map("would_case_have_failed_without_linter")
  wasHExpectedHere          Boolean @default(false) @map("was_h_expected_here")

  verdict                    String
  reasonShort               String @map("reason_short") @db.Text
  notesOptional             String? @map("notes_optional") @db.Text
}
