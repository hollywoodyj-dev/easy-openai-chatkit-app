{
  "expo": {
    "name": "Wisewave",
    "slug": "wisewave-chatkit-app",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "wisewave",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.wisewave.chatkit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.wisewave.chatkit",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1780162-70be-4694-aba9-a83370185fa3"
      }
    }
  }
}
