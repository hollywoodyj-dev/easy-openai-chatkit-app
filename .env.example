# Required: Get from https://platform.openai.com/api-keys (same org & project as Agent Builder)
OPENAI_API_KEY=

# Required: Get from Agent Builder after publishing your workflow — https://platform.openai.com/agent-builder
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=

# Optional: Custom ChatKit API base URL (leave unset to use default)
# CHATKIT_API_BASE=

# Optional: For Option B (backend turn API) chat model. Defaults to gpt-5.4 if unset.
# OPENAI_CHAT_MODEL=gpt-5.4

# Optional: System prompt for /chat (Option B) so the bot matches your Wisewave/ChatKit workflow.
# Copy the instructions from Agent Builder (workflow instructions) into this variable.
# Use \n for new lines, or keep on one line. If unset, the turn API uses no system message (plain model).
# OPENAI_CHAT_SYSTEM_PROMPT=You are the WiseWave assistant. You help users with...

# Optional: Or put instructions in a file (path relative to project root) and set:
# OPENAI_CHAT_SYSTEM_PROMPT_FILE=prompts/wisewave-system.txt

# Optional but recommended for production: Your app's public URL (e.g. https://wisewave-chatkit-app-v2.vercel.app).
# Used for PayPal return/cancel URLs and post-payment redirect so OpenAI allowlist domain matches.
# NEXT_PUBLIC_APP_URL=

# Optional: API key for Agent Tasks API (/api/agent-tasks). If set, agent requests (get tasks, reply) must send this via x-api-key or Authorization: Bearer.
# AGENT_TASKS_API_KEY=

# Optional: Admin key for Agent Tasks. If set, use with agent=admin to get all tasks and with POST /api/agent-tasks/admin/reply to set multiple tasks.
# AGENT_TASKS_ADMIN_API_KEY=

# Optional: Admin email address. The user with this email will be allowed
# to access the admin backend (user & subscription management).
# ADMIN_EMAIL=

# PayPal Subscriptions (auto-renew): For monthly/yearly plan PayPal button integration.
# Get plan ID from PayPal Dashboard > Products & Services > Your Product > Plan ID (P-xxx).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PAYPAL_MONTHLY_PLAN_ID=
# NEXT_PUBLIC_PAYPAL_YEARLY_PLAN_ID=
