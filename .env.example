# --- Database (required for /chat Option B: session, messages, turn persistence) ---
# Prisma uses PostgreSQL. Without a valid DATABASE_URL, POST /api/chat/session returns 503 db_unreachable.
# Examples:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
#   (Neon, Supabase, Railway, etc. — paste the provider’s connection string)
# After setting URL: `npx prisma migrate deploy`  (or `npx prisma db push` for a quick local schema sync)
# DATABASE_URL=

# Required: Get from https://platform.openai.com/api-keys (same org & project as Agent Builder)
OPENAI_API_KEY=

# Required: Get from Agent Builder after publishing your workflow — https://platform.openai.com/agent-builder
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=

# Optional: Custom ChatKit API base URL (leave unset to use default)
# CHATKIT_API_BASE=

# Optional: For Option B (backend turn API) default fallback model.
# Capability-specific overrides below take precedence when set.
# OPENAI_CHAT_MODEL=gpt-5.4
# OPENAI_MODEL_CHAT_TURN=gpt-5.4
# OPENAI_MODEL_CHAT_SUMMARY=gpt-5.4
# OPENAI_MODEL_REFLECTION_CHECKPOINT=gpt-5.4
# OPENAI_MODEL_REFLECTION_EXTRACT=gpt-5.4
# Optional deprecation behavior for deprecated shutdown models:
# - warn (default): log a warning and continue
# - block: throw and fail the request path using that model
# OPENAI_MODEL_DEPRECATION_MODE=warn
# Optional key for /api/internal/model-compat (if unset, endpoint is open in local/dev)
# OPENAI_MODEL_COMPAT_API_KEY=
# Preflight checks:
# - npm run model-compat:report  (prints compatibility status)
# - npm run model-compat:check   (exits non-zero if deprecated model is selected)

# Optional: System prompt for /chat (Option B) so the bot matches your Wisewave/ChatKit workflow.
# Copy the instructions from Agent Builder (workflow instructions) into this variable.
# Use \n for new lines, or keep on one line. If unset, the turn API uses no system message (plain model).
# OPENAI_CHAT_SYSTEM_PROMPT=You are the WiseWave assistant. You help users with...

# Optional: Or put instructions in a file (path relative to project root) and set:
# OPENAI_CHAT_SYSTEM_PROMPT_FILE=prompts/wisewave-system.txt

# Optional but recommended for production: Your app's public URL (e.g. https://wisewave-chatkit-app-v2.vercel.app).
# Used for PayPal return/cancel URLs and post-payment redirect so OpenAI allowlist domain matches.
# NEXT_PUBLIC_APP_URL=

# Marketing /app page — store listing URLs (paid LP + download page)
# Google Play defaults to id=com.wisewave.chatkit if unset.
# NEXT_PUBLIC_WISEWAVE_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.wisewave.chatkit
# NEXT_PUBLIC_WISEWAVE_IOS_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# NEXT_PUBLIC_WISEWAVE_APP_SCHEME=wisewave

# Optional: API key for Agent Tasks API (/api/agent-tasks). If set, agent requests (get tasks, reply) must send this via x-api-key or Authorization: Bearer.
# AGENT_TASKS_API_KEY=

# Optional: Admin key for Agent Tasks. If set, use with agent=admin to get all tasks and with POST /api/agent-tasks/admin/reply to set multiple tasks.
# AGENT_TASKS_ADMIN_API_KEY=

# Optional: Admin email address. The user with this email will be allowed
# to access the admin backend (user & subscription management).
# ADMIN_EMAIL=

# PayPal Subscriptions (auto-renew): For monthly/yearly plan PayPal button integration.
# Get plan ID from PayPal Dashboard > Products & Services > Your Product > Plan ID (P-xxx).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PAYPAL_MONTHLY_PLAN_ID=
# NEXT_PUBLIC_PAYPAL_YEARLY_PLAN_ID=

# Optional: Milestone F embodiment cue on /api/chat/turn. Set to 0 to disable (server-side only).
# MILESTONE_F_EMBODIMENT=0

# Optional: Milestone G integration hint on system prompt (coherence, not new features). Set to 0 to disable.
# MILESTONE_G_INTEGRATION=0

# Optional: Milestone H (HC-OS addendum). Default off; set true/1 to enable:
# - Wisewave Light Mode v2 system appendix (main reflection: notice, not conclude) — Lumen Pass 5
# - Optional awareness_cue strip in API/UI
# ENABLE_H_CUE=true

# Optional: Milestone I (HC-OS addendum) soft continuity carry-over.
# Default off; set true/1 to enable (suppression-first; carry-over must remain subtle and removable).
# ENABLE_I_CARRYOVER=

# Optional: Milestone J — Micro-Shift / Embodied Effect Layer (HC-OS formal addendum).
# Default off; false/0/unset disables all J behavior (global kill switch per addendum §16).
# Do not enable in production until Wisewave + OctopusMind streams are locked (see AGENTS.md).
# ENABLE_J_MICROSHIFT=

# Optional: P0 — Reflection Entry (Wisewave Product Milestone P0; default off).
# When true/1: internal Opening Detection + ephemeral Reflection Mode system appendix on early turns.
# Preview-only QA path (Slice 1): set ENABLE_P0_REFLECTION_ENTRY=1 on Vercel **Preview** only.
# Production stays off until full Lumen sign-off; even if the flag is set on Production, runtime blocks
# unless P0_REFLECTION_ENTRY_ALLOW_PRODUCTION=1 (do not set until Tree/Lumen approve).
# Debug fields: debug_p0_* on POST /api/chat/turn. See docs/qa/P0_REFLECTION_ENTRY_LUMEN_FIXTURES_v1.md
# ENABLE_P0_REFLECTION_ENTRY=
# P0_REFLECTION_ENTRY_ALLOW_PRODUCTION=
# Client mirror for Slice 3 empty state + early-exit beacon (must match server flag on deploy):
# NEXT_PUBLIC_ENABLE_P0_REFLECTION_ENTRY=

# Optional: P1 Interaction Legibility — plain-text slice (default off).
# Preview QA PASS 2026-07-17. Tree authorized Production observation rollout 2026-07-17 (window → 2026-07-31 review).
# Production requires BOTH keys below on Production scope. No P1.1 / P1.2 / GR-1 flags.
# Lumen: docs/qa/P1_INTERACTION_LEGIBILITY_PREVIEW_SLICE_LUMEN_QA_2026-07-17.md
# Deploy checklist: docs/qa/P1_INTERACTION_LEGIBILITY_PRODUCTION_DEPLOY_CHECKLIST_2026-07-17.md
# NEXT_PUBLIC_ENABLE_P1_INTERACTION_LEGIBILITY=
# NEXT_PUBLIC_P1_INTERACTION_LEGIBILITY_ALLOW_PRODUCTION=
# Mirror Vercel env on client for production guard (Vercel injects when prefixed):
# NEXT_PUBLIC_VERCEL_ENV=

# Preview hosted QA when Vercel Authentication is on (local only — never commit the secret):
# P0_VERCEL_PROTECTION_BYPASS=

# Optional: Milestone H observation queue & logging UI (/internal/h-observation, /api/internal/h-observation/*).
# When set, API routes require the same value via x-h-observation-key or Authorization: Bearer.
# H_OBSERVATION_API_KEY=

# Optional: Writable directory for observation JSON (queue, reviews, snapshots). Unset = local ./data/h-observation;
# on Vercel (VERCEL=1) defaults to /tmp/h-observation (ephemeral). Set explicitly for a mounted volume if you have one.
# H_OBSERVATION_DATA_DIR=/tmp/h-observation

# iOS Subscriptions (App Store receipt verification)
# For /api/subscription/verify-ios legacy path (verifyReceipt): required when the client
# sends receiptData. The mobile app may omit receiptData when transaction IDs are present
# and Apple Server API (below) verifies the purchase.
# APP-Store shared secret from App Store Connect (Not your Apple Developer Program account).
APPLE_SHARED_SECRET=
# Optional fallback if you also keep an app-specific secret.
# The verifier now accepts either value (and trims whitespace/newlines).
# APPLE_APP_SPECIFIC_SHARED_SECRET=
# Optional: Your iOS app bundle id (used for tighter verification in the future).
APPLE_BUNDLE_ID=com.wisewave.chatkit

# Marketing / conversion tracking (GA4 + admin funnel review)
# G-XXXXXXXXXX from Google Analytics 4 — loads gtag on the marketing site when set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# iOS Subscriptions (Apple Server API, preferred)
# If these are set, /api/subscription/verify-ios can verify using only transactionId /
# originalTransactionId (no receiptData). It falls back to verifyReceipt when the API
# returns receipt_data_required or when the client sends receiptData with the request.
#
# APPLE_SERVER_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_SERVER_API_KEY_ID=ABCDE12345
# APPLE_SERVER_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional override (otherwise APPLE_BUNDLE_ID is used):
# APPLE_SERVER_API_BUNDLE_ID=com.wisewave.chatkit
